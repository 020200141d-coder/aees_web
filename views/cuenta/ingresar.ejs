<%#
  cuenta/ingresar.ejs — registro / ingreso del cliente.
  1. Google (lo más rápido, si hay GOOGLE_CLIENT_ID): botón oficial de Google Identity
     Services. El callback envía el token a POST /cuenta/google, que lo verifica con Google.
     Si es la primera vez, después se pide SOLO el celular (/cuenta/completar).
  2. Correo + celular (cualquier correo; para quien no tiene Gmail): POST /cuenta/ingresar.
     Si es nuevo, pide su nombre. Google va primero porque es un toque y Google ya verificó el correo.
     Si su celular tenía una cuenta antigua con PIN, pide el PIN una sola vez (datos.pedirPin).
  En ambos casos queda recordado 6 meses en el dispositivo (DIAS_CLIENTE en middleware/auth.js).
%>
<%- include('../partials/head') %>
<body>
<%- include('../partials/header', { solido: true }) %>
<main class="pagina">
  <div class="contenedor ingreso">
    <header class="pagina-titulo" style="text-align:center">
      <span class="seccion-num">Tu cuenta</span>
      <h1>Ingresa <span class="texto-acento">en un clic</span></h1>
      <p style="margin:0 auto">Sin contraseñas. Te recordamos en este dispositivo, sumas puntos con cada evento y reservas más rápido.</p>
    </header>

    <section class="panel">
      <% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>

      <% if (googleClientId) { %>
        <%# Opción principal: Google. Si es nuevo, el siguiente paso solo pide el celular. %>
        <div class="ingreso-google">
          <div id="g_id_onload" data-client_id="<%= googleClientId %>" data-callback="aeesGoogle" data-auto_prompt="false" data-ux_mode="popup" data-volver="<%= volver %>"></div>
          <%# Se ve nuestro botón (.google-boton-cara); encima, casi invisible, el oficial de Google recibe el toque. %>
          <div class="google-boton google-boton-ingreso">
            <span class="google-boton-cara" aria-hidden="true"><%- include('../partials/google-g') %> Continuar con Google</span>
            <div class="g_id_signin google-boton-real" data-type="standard" data-shape="pill" data-theme="outline" data-size="large" data-text="continue_with" data-locale="es" data-width="320"></div>
          </div>
          <small class="suave"><b>Recomendado</b> si tienes Gmail: un toque y listo. Si es tu primera vez, luego solo te pedimos tu celular.</small>
        </div>
        <details class="otra-forma"<%= error || datos.email ? ' open' : '' %>>
          <summary>¿No tienes Gmail? Ingresa con tu correo y celular</summary>
      <% } %>

      <form method="post" action="/cuenta/ingresar" style="display:grid;gap:.9rem;margin-top:.8rem">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="volver" value="<%= volver %>">
        <label class="campo-simple">Tu correo <small>(Gmail, Hotmail, Outlook, el que uses)</small><input name="email" type="email" inputmode="email" maxlength="120" placeholder="tunombre@correo.com" value="<%= datos.email || '' %>" autocomplete="email" required <%= googleClientId ? '' : 'autofocus' %>></label>
        <label class="campo-simple">Celular (WhatsApp)<input name="celular" inputmode="tel" maxlength="12" placeholder="987 654 321" value="<%= datos.celular || '' %>" autocomplete="tel" required></label>
        <% if (datos.pedirPin) { %>
          <label class="campo-simple">PIN de tu cuenta anterior <small>(solo esta vez)</small><input name="pin" type="password" inputmode="numeric" maxlength="6" pattern="\d{6}" autocomplete="current-password" required></label>
        <% } %>
        <label class="campo-simple">Tu nombre <small>(solo la primera vez)</small><input name="nombre" maxlength="80" value="<%= datos.nombre || '' %>" autocomplete="name" <%= datos.nuevo ? 'required' : '' %>></label>
        <button class="btn <%= googleClientId ? 'btn-ghost' : 'btn-primario' %> btn-bloque"><i class="fa-solid fa-right-to-bracket"></i> Ingresar o crear mi cuenta</button>
      </form>

      <% if (googleClientId) { %></details><% } %>

      <ul class="suave beneficios-cuenta">
        <li><i class="fa-solid fa-star"></i> 1 punto por cada S/ 100; cada 5 puntos = S/ 50 de descuento.</li>
        <li><i class="fa-solid fa-rotate-right"></i> Repite una reserva anterior con un clic.</li>
        <li><i class="fa-solid fa-id-card"></i> Tus datos quedan guardados para la próxima reserva.</li>
      </ul>
      <p class="suave" style="font-size:.8rem;margin-top:1rem;text-align:center">¿Cambiaste de número? Escríbenos por <a href="https://wa.me/<%= negocio.whatsapp %>" style="color:var(--primario)">WhatsApp</a> y lo actualizamos.</p>
    </section>
  </div>
</main>

<% if (googleClientId) { %>
<%# El callback aeesGoogle está en public/js/google.js (lo comparte la invitación de la portada). %>
<script src="/js/google.js?v=<%= v %>"></script>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<% } %>
<%- include('../partials/footer') %>
