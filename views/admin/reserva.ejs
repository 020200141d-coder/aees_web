<%#
  admin/reserva.ejs — detalle de una reserva para el admin:
  cliente y contacto, equipos, desglose, pagos (aprobar/rechazar Yape, registrar pago manual),
  cambio de estado, reunión solicitada, ruta para el conductor y notas internas.
%>
<% const { soles, fechaLarga, ESTADOS_RESERVA, TIPOS_EVENTO } = util; const dc = r.datos_cliente || {}; const ruta = r.encuesta?.ruta; %>
<%- include('_inicio') %>
<header class="admin-cabecera">
  <div><h1>Reserva <%= r.codigo %></h1><p><%= fechaLarga(r.fecha_evento) %> · <span class="estado-reserva estado-<%= r.estado %>" style="font-size:.78rem"><%= ESTADOS_RESERVA[r.estado] %></span></p></div>
  <div class="acciones">
    <a class="btn btn-wa btn-sm" target="_blank" rel="noopener" href="https://wa.me/51<%= dc.celular %>?text=<%= encodeURIComponent(`Hola ${dc.nombre}, te escribe AeeS Acústico por tu reserva ${r.codigo} del ${r.fecha_evento}.`) %>"><i class="fa-brands fa-whatsapp"></i> Escribir al cliente</a>
    <a class="btn btn-ghost btn-sm" href="/reservas/<%= r.codigo %>" target="_blank">Ver como cliente</a>
    <a class="btn btn-ghost btn-sm" href="/admin/reservas"><i class="fa-solid fa-arrow-left"></i> Volver</a>
  </div>
</header>

<div class="rejilla rejilla-2">
  <div>
    <section class="tarjeta">
      <h2><i class="fa-solid fa-champagne-glasses"></i> Evento</h2>
      <div class="info-ruta">
        <div class="dato"><small>Tipo</small><b><%= TIPOS_EVENTO[r.tipo_evento]?.label || r.tipo_evento %></b></div>
        <div class="dato"><small>Invitados · espacio</small><b><%= r.personas || '?' %> · <%= r.espacio %></b></div>
        <div class="dato"><small>Hora · duración</small><b><%= r.hora_inicio || '—' %> · <%= r.horas %> h</b></div>
        <div class="dato"><small>Transporte</small><b><%= r.vehiculo || '—' %> · <%= r.distancia_km || '?' %> km</b></div>
      </div>
      <p style="margin-top:.8rem"><i class="fa-solid fa-location-dot" style="color:var(--secundario)"></i> <%= r.lugar %></p>
      <% if (r.lat) { %><p style="margin-top:.4rem"><a class="btn btn-ghost btn-sm" target="_blank" rel="noopener" href="<%= ruta?.enlace_conductor || `https://www.google.com/maps/dir/?api=1&destination=${r.lat},${r.lng}` %>"><i class="fa-solid fa-route"></i> Ruta para el conductor (Google Maps)</a> <% if (r.encuesta?.carga) { %><small class="suave">Carga: <%= r.encuesta.carga.volumen_l %> L · <%= r.encuesta.carga.peso_kg %> kg · pieza más larga <%= r.encuesta.carga.largo_cm %> cm</small><% } %></p><% } %>
    </section>

    <section class="tarjeta">
      <h2><i class="fa-solid fa-boxes-stacked"></i> Equipos a preparar</h2>
      <ul class="lista-check">
        <% (r.items || []).forEach(it => { %><li><b><%= it.cantidad %>×</b>&nbsp;<%= it.nombre || it.equipo_id %></li><% }) %>
      </ul>
      <div class="resumen-precio" style="margin-top:1rem">
        <% (r.encuesta?.lineas || []).forEach(l => { %><div><span><%= l.tipo === 'equipo' ? `${l.cantidad}× ` : '' %><%= l.nombre %></span><span><%= soles(l.subtotal) %></span></div><% }) %>
        <div><span>Técnico</span><span><%= soles(r.tecnico) %></span></div>
        <div><span>Transporte</span><span><%= soles(r.transporte) %></span></div>
        <% if (Number(r.descuento)) { %><div><span>Descuento <%= r.promo_codigo || '' %></span><span>− <%= soles(r.descuento) %></span></div><% } %>
        <div class="total"><span>Total</span><b><%= soles(r.total) %></b></div>
        <div class="adelanto"><span>Adelanto <%= r.adelanto_pct %>% · pagado</span><span><%= soles(r.adelanto) %> · <%= soles(r.pagado) %></span></div>
        <div><span>Saldo por cobrar el día del evento</span><b><%= soles(Math.max(0, r.total - (r.pagado || 0))) %></b></div>
      </div>
      <% const hist = r.encuesta?.historial_precios || []; const td = r.encuesta?.transporte_detalle; %>
      <% if (td) { %><p class="suave" style="font-size:.8rem;margin-top:.6rem"><i class="fa-solid fa-truck"></i> Transporte <%= td.gratis ? 'incluido por paquete' : 'cobrado' %><%= td.tarifa ? ` (tarifa ${soles(td.tarifa)})` : '' %><%= td.altura_m ? ` · lugar a ${td.altura_m} m` : '' %> · acceso vehicular: <b><%= r.encuesta.acceso_vehicular === false ? 'NO (cargar a mano)' : r.encuesta.acceso_vehicular ? 'sí' : 'sin dato' %></b></p><% } %>

      <%# Ajuste manual: el precio quedó congelado al reservar; solo se cambia aquí, con motivo y contraseña. %>
      <details style="margin-top:1rem">
        <summary class="btn btn-ghost btn-sm"><i class="fa-solid fa-pen"></i> Ajustar el precio de esta reserva</summary>
        <% if (['completada', 'cancelada', 'expirada'].includes(r.estado)) { %>
          <p class="suave" style="margin-top:.6rem">Esta reserva está <b><%= ESTADOS_RESERVA[r.estado] %></b>: su precio ya no se puede cambiar.</p>
        <% } else { %>
          <form method="post" action="/admin/reservas/<%= r.codigo %>/precio" data-pedir-clave data-confirmar="Cambiar el total de la reserva <%= r.codigo %>" style="display:grid;gap:.6rem;margin-top:.8rem">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <% if (Number(r.pagado) > 0) { %><div class="aviso"><i class="fa-solid fa-triangle-exclamation"></i>El cliente ya pagó <%= soles(r.pagado) %> (estado: <%= ESTADOS_RESERVA[r.estado] %>). Avísale del nuevo saldo.</div><% } %>
            <label class="campo-simple">Nuevo total (S/)<input name="total_nuevo" type="number" step="0.01" min="<%= Number(r.pagado || 0) %>" value="<%= r.total %>" required></label>
            <label class="campo-simple">Motivo (queda en el historial)<input name="motivo" maxlength="300" required placeholder="Ej.: cliente habitual, se acordó sin sub en la reunión"></label>
            <small class="suave">El adelanto se recalcula al <%= r.adelanto_pct %>%.</small>
            <button class="btn btn-primario btn-sm" style="justify-self:start">Guardar nuevo total</button>
          </form>
        <% } %>
      </details>
      <% if (hist.length) { %>
        <h3 style="font-size:.9rem;margin-top:1rem">Historial de precio</h3>
        <ul class="lista-check" style="font-size:.82rem">
          <% hist.slice().reverse().forEach(h => { %><li><span><b><%= soles(h.de) %> → <%= soles(h.a) %></b> · <%= new Date(h.fecha).toLocaleString('es-PE', { timeZone: 'America/Lima' }) %> · <%= h.por %> · estado <%= ESTADOS_RESERVA[h.estado] || h.estado %>, pagado <%= soles(h.pagado) %><br><small class="suave"><%= h.motivo %></small></span></li><% }) %>
        </ul>
      <% } %>
    </section>

    <%# Editar datos del evento (si cambia la fecha se revisa el stock). El precio se cambia aparte. %>
    <% if (!['completada', 'cancelada', 'expirada'].includes(r.estado)) { %>
    <section class="tarjeta">
      <details>
        <summary class="btn btn-ghost btn-sm"><i class="fa-solid fa-pen-to-square"></i> Editar datos del evento</summary>
        <form method="post" action="/admin/reservas/<%= r.codigo %>/editar" style="display:grid;gap:.6rem;margin-top:.8rem">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="form-rejilla">
            <label class="campo-simple">Fecha<input type="date" name="fecha_evento" value="<%= r.fecha_evento %>" required></label>
            <label class="campo-simple">Hora<input type="time" name="hora_inicio" value="<%= r.hora_inicio || '' %>"></label>
            <label class="campo-simple">Horas<input type="number" name="horas" min="1" max="24" value="<%= r.horas %>"></label>
            <label class="campo-simple">Invitados<input type="number" name="personas" min="0" value="<%= r.personas || 0 %>"></label>
            <label class="campo-simple">Tipo<select name="tipo_evento"><% Object.entries(TIPOS_EVENTO).forEach(([id, t]) => { %><option value="<%= id %>" <%= r.tipo_evento === id ? 'selected' : '' %>><%= t.label %></option><% }) %></select></label>
            <label class="campo-simple">¿Llega el vehículo?<select name="acceso_vehicular"><option value="si" <%= r.encuesta?.acceso_vehicular !== false ? 'selected' : '' %>>Sí</option><option value="no" <%= r.encuesta?.acceso_vehicular === false ? 'selected' : '' %>>No</option></select></label>
            <label class="campo-simple ancho">Lugar (texto)<input name="lugar" value="<%= r.lugar || '' %>" maxlength="200"></label>
            <label class="casilla ancho"><input type="checkbox" name="permitir_faltantes"> Si cambia la fecha, reservar igual aunque falte un equipo (proveedor aliado)</label>
          </div>
          <small class="suave">El precio no cambia solo: si cambian las horas o los equipos, usa "Ajustar el precio".</small>
          <button class="btn btn-primario btn-sm" style="justify-self:start">Guardar cambios</button>
        </form>
      </details>
    </section>
    <% } %>

    <section class="tarjeta">
      <h2><i class="fa-solid fa-note-sticky"></i> Notas internas</h2>
      <form method="post" action="/admin/reservas/<%= r.codigo %>/notas" style="display:grid;gap:.6rem">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label class="campo-simple"><span class="oculto-accesible">Notas</span><textarea name="notas_admin" placeholder="Ej.: 2 EON615 los pone el proveedor aliado X; montaje desde las 15:00."><%= r.notas_admin || '' %></textarea></label>
        <button class="btn btn-ghost btn-sm" style="justify-self:start">Guardar notas</button>
      </form>
    </section>
  </div>

  <div>
    <section class="tarjeta">
      <h2><i class="fa-solid fa-user"></i> Cliente</h2>
      <p><b><%= dc.nombre %></b><% if (cliente) { %> · <a href="/admin/clientes/<%= cliente.id %>" style="color:var(--primario);font-size:.85rem">ver ficha</a><% } %></p>
      <p class="suave">DNI <%= dc.dni %> · <i class="fa-brands fa-whatsapp"></i> <%= dc.celular %><%= dc.correo ? ` · ${dc.correo}` : '' %></p>
      <% if (cliente) { %><p class="suave" style="font-size:.8rem">Cuenta: <%= cliente.email || cliente.celular %></p><% } %>
    </section>

    <%# Reunión o llamada de confirmación: la agenda el admin o el dueño. Sin ella no se puede pasar a "Confirmada". %>
    <section class="tarjeta">
      <h2><i class="fa-solid fa-handshake"></i> Reunión o llamada</h2>
      <% if (r.reunion?.agendada_por === 'admin') { %>
        <div class="aviso aviso-ok" style="margin-bottom:.8rem"><i class="fa-solid fa-calendar-check"></i>Agendada: <b><%= r.reunion.fecha %> <%= r.reunion.hora %></b> (<%= r.reunion.modalidad %>)<%= r.reunion.nota ? ` · ${r.reunion.nota}` : '' %></div>
      <% } else if (r.reunion) { %>
        <div class="aviso" style="margin-bottom:.8rem"><i class="fa-solid fa-hourglass-half"></i>El cliente propuso: <b><%= r.reunion.fecha %> <%= r.reunion.hora %></b> (<%= r.reunion.modalidad %>). Acéptalo o cámbialo:</div>
      <% } else { %>
        <p class="suave" style="font-size:.85rem;margin-bottom:.8rem">Confirma con el cliente los equipos, el lugar, la energía y la protección ante el clima. El evento pasa a "Confirmada" después de esta reunión.</p>
      <% } %>
      <form method="post" action="/admin/reservas/<%= r.codigo %>/reunion" style="display:grid;gap:.6rem">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="form-rejilla">
          <label class="campo-simple">Fecha<input type="date" name="fecha" max="<%= r.fecha_evento %>" value="<%= r.reunion?.fecha || '' %>" required></label>
          <label class="campo-simple">Hora<input type="time" name="hora" value="<%= r.reunion?.hora || '' %>" required></label>
          <label class="campo-simple">Modalidad
            <select name="modalidad"><% [['llamada', 'Llamada'], ['videollamada', 'Videollamada por WhatsApp'], ['presencial', 'Presencial / visita al lugar']].forEach(([v, t]) => { %><option value="<%= v %>" <%= r.reunion?.modalidad === v ? 'selected' : '' %>><%= t %></option><% }) %></select>
          </label>
          <label class="campo-simple">Nota para el cliente<input name="nota" maxlength="200" value="<%= r.reunion?.nota || '' %>" placeholder="Ej.: llevar plano del local"></label>
        </div>
        <button class="btn btn-primario btn-sm" style="justify-self:start"><%= r.reunion?.agendada_por === 'admin' ? 'Cambiar horario' : 'Agendar' %></button>
      </form>
    </section>

    <section class="tarjeta">
      <h2><i class="fa-solid fa-arrows-rotate"></i> Estado</h2>
      <form method="post" action="/admin/reservas/<%= r.codigo %>/estado" class="acciones">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <select name="estado" class="estado-select" style="padding:.55rem">
          <% Object.entries(ESTADOS_RESERVA).forEach(([k, v]) => { %><option value="<%= k %>" <%= r.estado === k ? 'selected' : '' %>><%= v %></option><% }) %>
        </select>
        <button class="btn btn-primario btn-sm">Cambiar</button>
      </form>
      <p class="suave" style="font-size:.78rem;margin-top:.6rem">Flujo: pendiente → adelanto pagado → <b>confirmada</b> (después de la reunión) → completada.</p>
      <%# Eliminar: para errores o pruebas (pide contraseña). Para el historial es mejor "Cancelada". %>
      <form method="post" action="/admin/reservas/<%= r.codigo %>/eliminar" data-confirmar="¿Eliminar la reserva <%= r.codigo %> y sus pagos? Para el historial es mejor cambiarla a Cancelada." style="margin-top:.8rem"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost btn-sm"><i class="fa-regular fa-trash-can"></i> Eliminar reserva</button></form>
    </section>

    <section class="tarjeta">
      <h2><i class="fa-solid fa-money-bill-wave"></i> Pagos</h2>
      <% if (!pagos.length) { %><p class="suave">Sin pagos todavía.</p><% } %>
      <div class="lista-agenda">
        <% pagos.forEach(p => { %>
          <div class="mensaje">
            <b><%= p.metodo === 'yape' ? (p.detalle?.app === 'plin' ? 'Plin' : p.detalle?.comprobante ? 'Yape' : 'Yape / manual') : { mercadopago: 'Mercado Pago', simulado: 'Simulado' }[p.metodo] %> · <%= soles(p.monto) %></b>
            <% if (p.detalle?.comprobante) { %><a href="/admin/pagos/<%= p.id %>/comprobante" target="_blank" rel="noopener" class="comprobante-mini" title="Abrir el comprobante"><img src="/admin/pagos/<%= p.id %>/comprobante" alt="Comprobante de pago" loading="lazy"></a><% } %>
            <small class="suave">Ref. <%= p.referencia %> · <%= new Date(p.creado_en).toLocaleString('es-PE', { timeZone: 'America/Lima' }) %> · <b style="color:<%= p.estado === 'aprobado' ? 'var(--disponible)' : p.estado === 'rechazado' ? 'var(--no-disponible)' : 'var(--primario)' %>"><%= p.estado %></b></small>
            <% if (p.estado === 'pendiente') { %>
              <div class="mensaje-pie">
                <form method="post" action="/admin/pagos/<%= p.id %>/aprobar"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-primario btn-sm">Aprobar</button></form>
                <form method="post" action="/admin/pagos/<%= p.id %>/rechazar" data-confirmar="¿Rechazar este pago?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost btn-sm">Rechazar</button></form>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
      <form method="post" action="/admin/reservas/<%= r.codigo %>/pago-manual" class="fila-form" style="margin-top:1rem">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input name="monto" type="number" step="0.01" min="0.01" placeholder="Monto S/" required aria-label="Monto">
        <input name="referencia" maxlength="40" placeholder="Referencia (efectivo, transferencia…)" aria-label="Referencia">
        <button class="btn btn-ghost btn-sm">Registrar pago</button>
      </form>
    </section>
  </div>
</div>
<%- include('_fin') %>
