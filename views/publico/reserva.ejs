<%#
  publico/reserva.ejs — estado de una reserva y pago del adelanto.
  Pasos visibles: reserva creada → adelanto → reunión de confirmación → evento.
  Métodos de pago:
   • Yape o Plin (principal): QR + monto, el cliente sube la foto del comprobante y el
     n.º de operación (public/js/reserva.js → POST /pagos/:codigo/yape) y avisa por
     WhatsApp con el mensaje ya escrito. El admin lo verifica y aprueba en el panel.
   • Mercado Pago (tarjeta), solo si hay MP_ACCESS_TOKEN.
   • Pago simulado, solo en desarrollo.
  Al final, las condiciones del servicio (negocio.clausulas, editables en Ajustes).
%>
<%
  const { soles, fechaLarga, ESTADOS_RESERVA, TIPOS_EVENTO } = util;
  const porPagar = Math.max(0, Math.round((r.adelanto - (r.pagado || 0)) * 100) / 100);
  const pagada = ['adelanto_pagado', 'confirmada', 'completada'].includes(r.estado);
  const yapePendiente = pagos.find(p => p.metodo === 'yape' && p.estado === 'pendiente');
  const yapeRechazado = !yapePendiente && pagos.filter(p => p.metodo === 'yape').slice(-1)[0]?.estado === 'rechazado';
  const appPago = p => (p?.detalle?.app === 'plin' ? 'Plin' : 'Yape');
  const avisoWa = yapePendiente ? `Hola AeeS, pagué el adelanto de mi reserva ${r.codigo} (${r.fecha_evento}) por ${soles(yapePendiente.monto)} con ${appPago(yapePendiente)}. N.º de operación: ${yapePendiente.referencia}. Ya subí la foto del comprobante en la web.` : '';
  const numero = v => String(v || '').replace(/(\d{3})(\d{3})(\d{3})/, '$1 $2 $3');
  const billeteras = [['yape', 'Yape', negocio.yape, '#742284'], ['plin', 'Plin', negocio.plin, '#00b4c5']].filter(([, , d]) => d?.numero || d?.qr_url);
  const wa = `Hola AeeS, tengo la reserva ${r.codigo} para el ${r.fecha_evento}.`;
  const lineas = r.encuesta?.lineas || [];
  const hitos = [
    ['Reserva creada', `Equipos bloqueados${r.expira_en && r.estado === 'pendiente_pago' ? ` hasta el ${new Date(r.expira_en).toLocaleString('es-PE', { timeZone: 'America/Lima', dateStyle: 'medium', timeStyle: 'short' })}` : ''}`, true],
    [`Adelanto del ${r.adelanto_pct}%`, pagada ? `Pagado: ${soles(r.pagado)}` : `Por pagar: ${soles(porPagar)}`, pagada],
    ['Reunión o llamada de confirmación', r.reunion ? `${r.reunion.fecha} ${r.reunion.hora} · ${r.reunion.modalidad}${r.reunion.agendada_por === 'admin' ? ' (agendada por AeeS)' : ' (solicitada)'}` : 'AeeS la agenda contigo: ahí se confirma tu evento', ['confirmada', 'completada'].includes(r.estado)],
    ['Tu evento', fechaLarga(r.fecha_evento), r.estado === 'completada']
  ];
  const actual = hitos.findIndex(h => !h[2]);
%>
<%- include('../partials/head') %>
<body>
<%- include('../partials/header', { solido: true }) %>
<main class="pagina">
  <div class="contenedor">
    <header class="pagina-titulo">
      <span class="seccion-num">Reserva</span>
      <h1><%= r.codigo %></h1>
      <span class="estado-reserva estado-<%= r.estado %>"><%= ESTADOS_RESERVA[r.estado] %></span>
    </header>
    <%- include('../partials/flash') %>

    <div class="dos-columnas">
      <div style="display:grid;gap:1.4rem">
        <section class="panel">
          <h2 style="font-size:1.3rem;margin-bottom:.8rem">Tu evento</h2>
          <div class="info-ruta" style="margin-bottom:1.2rem">
            <div class="dato"><small>Fecha</small><b><%= fechaLarga(r.fecha_evento) %></b></div>
            <div class="dato"><small>Hora y duración</small><b><%= r.hora_inicio || 'por definir' %> · <%= r.horas %> h</b></div>
            <div class="dato"><small>Tipo</small><b><%= TIPOS_EVENTO[r.tipo_evento]?.label || 'Evento' %><%= r.personas ? ` · ${r.personas} pers.` : '' %></b></div>
            <div class="dato"><small>Lugar</small><b><%= (r.lugar || '').split(',').slice(0, 2).join(',') %></b></div>
          </div>
          <div class="lineas">
            <% lineas.forEach(l => { %>
              <div class="linea"><div><b><%= l.tipo === 'adicional' ? '+ ' : '' %><%= l.nombre %></b><% if (l.detalle) { %><small><%= l.detalle.join(' · ') %></small><% } else if (l.tipo === 'equipo') { %><small><%= l.cantidad %> × <%= soles(l.precio_unit) %></small><% } %></div><span></span><span class="precio"><%= soles(l.subtotal) %></span></div>
            <% }) %>
          </div>
          <div class="resumen-precio" style="margin-top:1rem">
            <div><span>Equipos</span><span><%= soles(r.subtotal) %></span></div>
            <div><span>Técnico</span><span><%= soles(r.tecnico) %></span></div>
            <div><span>Transporte <%= r.vehiculo ? `· ${r.vehiculo}` : '' %><%= r.distancia_km ? ` · ${r.distancia_km} km` : '' %></span><span><%= soles(r.transporte) %></span></div>
            <% if (Number(r.descuento)) { %><div style="color:var(--disponible)"><span>Descuento<%= r.promo_codigo ? ` (${r.promo_codigo})` : '' %></span><span>− <%= soles(r.descuento) %></span></div><% } %>
            <div class="total"><span>Total</span><b><%= soles(r.total) %></b></div>
            <div class="adelanto"><span>Adelanto (<%= r.adelanto_pct %>%)</span><span><%= soles(r.adelanto) %></span></div>
          </div>
          <% if (r.explicacion) { %><div class="explicacion" style="margin-top:1.2rem"><p><%= r.explicacion %></p></div><% } %>
        </section>
      </div>

      <aside style="display:grid;gap:1.4rem">
        <section class="panel">
          <h2 style="font-size:1.2rem;margin-bottom:.6rem">Progreso</h2>
          <div class="linea-tiempo">
            <% hitos.forEach(([titulo, detalle, hecho], i) => { %>
              <div class="hito <%= hecho ? 'hecho' : i === actual ? 'actual' : '' %>"><i class="fa-solid <%= hecho ? 'fa-check' : 'fa-circle' %>"></i><div><b><%= titulo %></b><small><%= detalle %></small></div></div>
            <% }) %>
          </div>
        </section>

        <% if (r.estado === 'pendiente_pago') { %>
          <section class="panel">
            <h2 style="font-size:1.2rem;margin-bottom:.4rem">Paga el adelanto: <span class="texto-acento"><%= soles(porPagar) %></span></h2>
            <p class="suave" style="font-size:.88rem;margin-bottom:1rem">Elige cómo pagar. Con el adelanto tu fecha y tus equipos quedan separados.</p>
            <div class="metodos">
              <div class="metodo metodo-billetera">
                <h3><i class="fa-solid fa-qrcode" style="color:var(--primario)"></i> Yape o Plin</h3>
                <% if (yapePendiente) { %>
                  <div class="aviso aviso-ok"><i class="fa-solid fa-hourglass-half"></i>Recibimos tu comprobante (<%= appPago(yapePendiente) %>, operación <b><%= yapePendiente.referencia %></b>). Lo estamos verificando.</div>
                  <a class="btn btn-wa btn-bloque" style="margin-top:.8rem" target="_blank" rel="noopener" href="https://wa.me/<%= negocio.whatsapp %>?text=<%= encodeURIComponent(avisoWa) %>"><i class="fa-brands fa-whatsapp"></i> Avisar por WhatsApp que ya pagué</a>
                <% } else { %>
                  <% if (yapeRechazado) { %><div class="aviso" style="margin-bottom:.8rem"><i class="fa-solid fa-circle-exclamation"></i>No pudimos verificar tu último comprobante. Revisa el monto y el número de operación, o escríbenos por WhatsApp.</div><% } %>
                  <ol class="pasos-pago">
                    <li>Escanea el QR o paga al número con <b>Yape o Plin</b>: <b class="monto-pagar"><%= soles(porPagar) %></b>
                      <button type="button" class="btn-icono" data-copiar="<%= porPagar.toFixed(2) %>" aria-label="Copiar monto" title="Copiar monto"><i class="fa-regular fa-copy"></i></button></li>
                    <li>Toma una captura del comprobante.</li>
                    <li>Súbela aquí con el número de operación.</li>
                  </ol>
                  <% if (billeteras.length) { %>
                    <div class="billeteras">
                      <% billeteras.forEach(([id, nombre, d, color]) => { %>
                        <div class="billetera" style="--color-app:<%= color %>">
                          <b><%= nombre %></b>
                          <% if (d.qr_url) { %><img src="<%= d.qr_url %>" alt="QR de <%= nombre %> de <%= d.titular || negocio.nombre %>" loading="lazy"><% } %>
                          <% if (d.numero) { %><span class="yape-num"><%= numero(d.numero) %> <button type="button" class="btn-icono" data-copiar="<%= d.numero %>" aria-label="Copiar número de <%= nombre %>"><i class="fa-regular fa-copy"></i></button></span><% } %>
                          <% if (d.titular) { %><small class="suave">A nombre de <%= d.titular %></small><% } %>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>
                  <form id="form-comprobante" class="form-comprobante" data-codigo="<%= r.codigo %>" novalidate>
                    <fieldset class="elegir-app"><legend class="oculto-accesible">¿Con qué pagaste?</legend>
                      <label class="casilla"><input type="radio" name="metodo" value="yape" checked> Pagué con Yape</label>
                      <label class="casilla"><input type="radio" name="metodo" value="plin"> Pagué con Plin</label>
                    </fieldset>
                    <label class="subir-comprobante">
                      <input type="file" name="foto" accept="image/*" hidden>
                      <span class="vista-comprobante"><i class="fa-solid fa-camera"></i><span>Toca para subir la captura del comprobante</span></span>
                    </label>
                    <label class="campo-simple">N.º de operación<input name="operacion" inputmode="numeric" maxlength="12" placeholder="Ej.: 12345678" required></label>
                    <span class="campo-error" data-error-comprobante></span>
                    <button class="btn btn-primario btn-bloque"><i class="fa-solid fa-paper-plane"></i> Enviar comprobante</button>
                  </form>
                <% } %>
              </div>
              <% if (mpActivo) { %>
                <div class="metodo">
                  <h3><i class="fa-regular fa-credit-card" style="color:#00b1ea"></i> Tarjeta (Mercado Pago)</h3>
                  <p>Pago seguro en la página de Mercado Pago. Se confirma automáticamente.</p>
                  <form method="post" action="/pagos/<%= r.codigo %>/mercadopago"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-primario btn-bloque">Pagar <%= soles(porPagar) %></button></form>
                </div>
              <% } %>
              <% if (simulado) { %>
                <div class="metodo" style="border-style:dashed">
                  <h3><i class="fa-solid fa-flask"></i> Pago simulado (solo desarrollo)</h3>
                  <p>Para probar el flujo sin cuentas reales. No existe en producción.</p>
                  <form method="post" action="/pagos/<%= r.codigo %>/simular"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost btn-bloque">Simular pago aprobado</button></form>
                </div>
              <% } %>
            </div>
          </section>
        <% } %>

        <% if (pagada && r.estado !== 'completada') { %>
          <section class="panel">
            <h2 style="font-size:1.2rem;margin-bottom:.4rem">Reunión o llamada de confirmación</h2>
            <p class="suave" style="font-size:.88rem;margin-bottom:1rem">Conversamos para confirmar los equipos, el lugar, la energía y los horarios. <b>Tu evento queda confirmado en esa reunión o llamada.</b> Propón un horario y te lo confirmamos.</p>
            <% if (r.reunion?.agendada_por === 'admin') { %><div class="aviso aviso-ok" style="margin-bottom:1rem"><i class="fa-solid fa-calendar-check"></i>Agendada por AeeS: <b><%= r.reunion.fecha %> a las <%= r.reunion.hora %></b> (<%= r.reunion.modalidad %>).<%= r.reunion.nota ? ` ${r.reunion.nota}` : '' %></div>
            <% } else if (r.reunion) { %><div class="aviso" style="margin-bottom:1rem"><i class="fa-solid fa-hourglass-half"></i>Propusiste: <%= r.reunion.fecha %> a las <%= r.reunion.hora %> (<%= r.reunion.modalidad %>). Te confirmamos por WhatsApp.</div><% } %>
            <%# Si AeeS ya agendó la reunión, el cliente ya no la cambia desde aquí (lo coordina por WhatsApp). %>
            <% if (r.reunion?.agendada_por !== 'admin') { %>
            <form method="post" action="/reservas/<%= r.codigo %>/reunion" style="display:grid;gap:.8rem">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <div class="dos-campos">
                <label class="campo-simple">Fecha<input type="date" name="fecha" min="<%= hoy %>" max="<%= r.fecha_evento %>" required></label>
                <label class="campo-simple">Hora<input type="time" name="hora" min="08:00" max="20:00" required></label>
              </div>
              <label class="campo-simple">Modalidad
                <select name="modalidad"><option value="videollamada">Videollamada por WhatsApp</option><option value="llamada">Llamada</option><option value="presencial">Presencial / visita al lugar</option></select>
              </label>
              <button class="btn btn-primario btn-sm"><%= r.reunion ? 'Proponer otro horario' : 'Proponer horario' %></button>
            </form>
            <% } %>
          </section>
        <% } %>

        <%# Condiciones del servicio: las mismas que aceptó al reservar. %>
        <section class="panel clausulas">
          <h2 style="font-size:1.1rem;margin-bottom:.6rem"><i class="fa-solid fa-file-contract"></i> Condiciones del servicio</h2>
          <ul><% negocio.clausulas.forEach(c => { %><li><%= c %></li><% }) %></ul>
        </section>

        <a class="btn btn-wa btn-bloque" target="_blank" rel="noopener" href="https://wa.me/<%= negocio.whatsapp %>?text=<%= encodeURIComponent(wa) %>"><i class="fa-brands fa-whatsapp"></i> Escribir sobre esta reserva</a>
      </aside>
    </div>
  </div>
</main>
<%- include('../partials/footer', { scripts: ['/js/reserva.js'] }) %>
