<%#
  publico/index.ejs — portada de AeeS Acústico (diseño "B": cotizador al frente).
  Es un RESUMEN: cada sección lleva a su página completa (/catalogo, /combos, /eventos).
  Orden pensado para el cliente:
   1. Hero: logo, frase, datos de confianza y el COTIZADOR RÁPIDO ("Desde S/ …" al instante).
   2. Promociones vigentes (Admin → Promociones).
   3. Cotizador con IA: escribe tu evento con tus palabras → /asistente?texto=…
   4. Equipos destacados (los 3 que marca el admin) → "Ver catálogo".
   5. Reseñas reales + fotos de eventos que cambian cada 2 s → "Ver eventos".
   6. Paquetes en oferta (el del medio, "Más elegido") → "Ver todos los combos".
   7. Cómo reservar y contacto. En el celular, barra fija "Cotizar / WhatsApp".
   + Invitación flotante "Crea tu cuenta en un toque" con Google (partials/aviso-cuenta.ejs).
  Datos: src/rutas/publico.js. Ganchos de JS: public/js/main.js y public/js/portada.js.
%>
<%
  const { soles } = util;
  const anios = anio - (negocio.anio_fundacion || 2019);
  const confianza = [
    negocio.eventos_realizados ? ['fa-solid fa-champagne-glasses', `+${negocio.eventos_realizados} eventos`] : ['fa-solid fa-award', `${anios} años en eventos`],
    ['fa-solid fa-mobile-screen', `Separas con el ${reglas.adelanto_pct}% por Yape o Plin`],
    ['fa-solid fa-truck', 'Transporte incluido en Cusco (paquetes)']
  ];
%>
<%- include('../partials/head') %>
<body class="portada">

<noscript><style>.hero-anim,[data-reveal]{opacity:1!important;translate:none!important}</style></noscript>

<%- include('../partials/header') %>

<main>
  <!-- ================= 1. HERO + COTIZADOR RÁPIDO ================= -->
  <section id="inicio" class="hero hero-b">
    <div class="hero-foto" style="background-image:url('<%= portada.hero %>')" aria-hidden="true"></div>
    <div class="haces" aria-hidden="true"><span class="haz haz-1"></span><span class="haz haz-2"></span><span class="haz haz-3"></span></div>
    <canvas id="hero-canvas" class="hero-canvas" aria-hidden="true"></canvas>

    <div class="contenedor hero-b-grid">
      <div class="hero-contenido">
        <span class="etiqueta hero-anim"><span class="punto-vivo"></span> Reservas abiertas · Cusco y Valle Sagrado</span>
        <h1 class="hero-anim hero-logo">
          <span class="oculto-accesible">AeeS Acústico: </span>
          <span aria-hidden="true"><%- include('../partials/logo', { completo: true, clase: 'logo-hero' }) %></span>
          <span class="h1-frase">Sonido, luces y LED para que tu evento <span class="texto-acento">suene perfecto</span></span>
        </h1>
        <ul class="confianza hero-anim">
          <% confianza.forEach(([icono, texto]) => { %><li><i class="<%= icono %>"></i> <%= texto %></li><% }) %>
        </ul>
        <div class="hero-acciones hero-anim">
          <a href="/combos" class="btn btn-ghost magnetico"><i class="fa-solid fa-box-open"></i> Ver paquetes</a>
          <a href="https://wa.me/<%= negocio.whatsapp %>?text=<%= encodeURIComponent('¡Hola AeeS! Quiero cotizar un evento.') %>" class="btn btn-wa magnetico" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>
        </div>
      </div>

      <%# Cotizador rápido: public/js/portada.js consulta POST /api/cotizacion-rapida en cada cambio. %>
      <form class="cotizador-rapido hero-anim" id="cotizador-rapido" novalidate aria-labelledby="titulo-cotizador">
        <h2 id="titulo-cotizador"><i class="fa-solid fa-bolt"></i> Cotiza en 10 segundos</h2>
        <label class="campo-simple">¿Qué evento es?
          <select name="tipo_evento">
            <% Object.entries(TIPOS_EVENTO).forEach(([id, t]) => { %><option value="<%= id %>" <%= id === 'cumpleanos' ? 'selected' : '' %>><%= t.label %></option><% }) %>
          </select>
        </label>
        <label class="campo-simple">Invitados: <output name="personas_valor">60</output>
          <input type="range" name="personas" min="20" max="500" step="10" value="60">
        </label>
        <div class="dos-opciones" role="radiogroup" aria-label="Lugar">
          <label><input type="radio" name="espacio" value="interior" checked><span><i class="fa-solid fa-building"></i> Cerrado</span></label>
          <label><input type="radio" name="espacio" value="exterior"><span><i class="fa-solid fa-tree"></i> Al aire libre</span></label>
        </div>
        <div class="dos-opciones" role="radiogroup" aria-label="¿El vehículo llega hasta el lugar?">
          <label><input type="radio" name="acceso_vehicular" value="si" checked><span><i class="fa-solid fa-truck"></i> El auto llega</span></label>
          <label><input type="radio" name="acceso_vehicular" value="no"><span><i class="fa-solid fa-person-walking"></i> No llega</span></label>
        </div>
        <label class="campo-simple">Fecha (opcional)<input type="date" name="fecha" min="<%= hoy %>"></label>
        <div class="resultado-rapido" aria-live="polite">
          <small id="rapido-nombre">Paquete sugerido</small>
          <strong id="rapido-precio">Desde S/ —</strong>
          <span id="rapido-detalle" class="suave"></span>
        </div>
        <div class="cotizador-acciones">
          <button type="button" class="btn btn-primario btn-bloque" id="rapido-reservar" hidden><i class="fa-solid fa-calendar-plus"></i> Reservar este paquete</button>
          <a class="btn btn-ghost btn-bloque" id="rapido-asistente" href="/asistente"><i class="fa-solid fa-wand-magic-sparkles"></i> Ver propuesta completa</a>
        </div>
      </form>
    </div>
  </section>

  <!-- ================= 2. PROMOCIONES ================= -->
  <% if (promos.length) { %>
  <section class="promos" aria-label="Promociones vigentes">
    <div class="contenedor promos-grid" data-stagger>
      <% promos.forEach(p => { %>
        <article class="promo" data-reveal>
          <span class="promo-pct">−<%= Number(p.porcentaje) %>%</span>
          <div>
            <b><%= p.descripcion || 'Descuento especial' %></b>
            <small>Código <code><%= p.codigo %></code><%= p.solo_frecuentes ? ' · clientes habituales' : '' %><%= p.vence ? ` · hasta el ${util.fechaLarga ? util.fechaLarga(p.vence) : p.vence}` : '' %></small>
          </div>
          <button type="button" class="btn-icono" data-copiar-codigo="<%= p.codigo %>" aria-label="Copiar el código <%= p.codigo %>"><i class="fa-regular fa-copy"></i></button>
        </article>
      <% }) %>
    </div>
  </section>
  <% } %>

  <!-- ================= 3. COTIZADOR CON IA ================= -->
  <section class="seccion">
    <div class="contenedor">
      <form class="cotizador-ia" action="/asistente" method="get" data-reveal>
        <div>
          <span class="seccion-num">¿Prefieres contarlo?</span>
          <h2>Escribe tu evento <span class="texto-acento">con tus palabras</span></h2>
          <p>Nuestro asistente lo entiende, arma el sonido con nuestras reglas y te da tres opciones con precio, transporte y el clima de tu fecha.</p>
        </div>
        <div class="cotizador-ia-campo">
          <label class="oculto-accesible" for="texto-ia">Cuéntanos tu evento</label>
          <textarea id="texto-ia" name="texto" rows="3" maxlength="1500" placeholder="Ej.: Boda de 120 invitados en Urubamba, en un jardín, con orquesta de 7 integrantes y DJ."></textarea>
          <div class="ejemplos-ia">
            <% ['Cumpleaños de 60 personas en San Jerónimo, 6 horas', 'Fiesta electrónica de 300 personas al aire libre', 'Quinceañero con orquesta de 8 integrantes'].forEach(t => { %>
              <button type="button" class="chip" data-ejemplo-ia="<%= t %>"><%= t %></button>
            <% }) %>
          </div>
          <button class="btn btn-coral magnetico"><i class="fa-solid fa-wand-magic-sparkles"></i> Armar mi propuesta</button>
        </div>
      </form>
    </div>
  </section>

  <!-- ================= 4. EQUIPOS DESTACADOS ================= -->
  <section id="equipos" class="seccion seccion-alt">
    <div class="contenedor">
      <header class="seccion-titulo seccion-titulo-flex" data-reveal>
        <div>
          <span class="seccion-num">Catálogo</span>
          <h2>Equipos destacados</h2>
          <p>Precio por evento de hasta <%= reglas.horas_jornada %> horas.</p>
        </div>
        <a href="/catalogo" class="btn btn-ghost">Ver los <%= total_equipos %> equipos <i class="fa-solid fa-arrow-right"></i></a>
      </header>
      <div class="grid-equipos grid-3" data-stagger>
        <% equipos.forEach(e => { %><%- include('../partials/equipo-card', { e }) %><% }) %>
      </div>
    </div>
  </section>

  <!-- ================= 5. RESEÑAS + FOTOS DE EVENTOS ================= -->
  <section class="seccion">
    <div class="contenedor">
      <header class="seccion-titulo seccion-titulo-flex" data-reveal>
        <div>
          <span class="seccion-num">Eventos</span>
          <h2><%= resenas.length ? 'Lo que dicen nuestros clientes' : 'Eventos que ya sonaron con AeeS' %></h2>
          <p>Fotos reales de nuestros montajes.</p>
        </div>
        <a href="/eventos" class="btn btn-ghost">Ver todos los eventos <i class="fa-solid fa-arrow-right"></i></a>
      </header>
      <div class="resenas-fotos<%= resenas.length ? '' : ' solo-fotos' %>">
        <% if (resenas.length) { %>
          <div class="resenas-lista" data-stagger>
            <% resenas.slice(0, 3).forEach(x => { %><div data-reveal><%- include('../partials/resena', { x }) %></div><% }) %>
          </div>
        <% } %>
        <%# Presentación de fotos: cambia cada 2 segundos (public/js/portada.js). Todas en caja 4:3. %>
        <div class="presentacion" id="presentacion" aria-roledescription="carrusel" aria-label="Fotos de eventos realizados" data-reveal>
          <% publicaciones.slice(0, 10).forEach((p, i) => { %>
            <figure class="diapositiva<%= i === 0 ? ' activa' : '' %>" aria-hidden="<%= i === 0 ? 'false' : 'true' %>">
              <img src="<%= p.imagen %>" alt="<%= p.titulo %>" <%= i > 1 ? 'loading="lazy"' : '' %>>
              <figcaption><%= p.titulo %></figcaption>
            </figure>
          <% }) %>
          <div class="presentacion-puntos" aria-hidden="true"><% publicaciones.slice(0, 10).forEach((p, i) => { %><span class="<%= i === 0 ? 'activo' : '' %>"></span><% }) %></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 6. PAQUETES EN OFERTA ================= -->
  <section id="combos" class="seccion seccion-alt">
    <div class="contenedor">
      <header class="seccion-titulo seccion-titulo-flex" data-reveal>
        <div>
          <span class="seccion-num">Ofertas</span>
          <h2>Paquetes que ahorran</h2>
          <p>Más barato que alquilar cada equipo por separado. Precio por evento de <%= reglas.horas_jornada %> horas.</p>
        </div>
        <a href="/combos" class="btn btn-ghost">Ver los <%= total_combos %> combos <i class="fa-solid fa-arrow-right"></i></a>
      </header>
      <div class="grid-combos grid-3" data-stagger>
        <% paquetes.forEach(c => { %><%- include('../partials/combo-card', { c, mapa, elegido: c.id === elegidoId }) %><% }) %>
      </div>
    </div>
  </section>

  <!-- ================= 7. CÓMO RESERVAR ================= -->
  <section class="seccion">
    <div class="contenedor">
      <header class="seccion-titulo" data-reveal>
        <span class="seccion-num">Así de simple</span>
        <h2>Reservar es fácil</h2>
      </header>
      <ol class="pasos-reserva" data-stagger>
        <% [
          ['fa-solid fa-calculator', 'Cotiza', 'Con el cotizador, un paquete o equipo por equipo. Ves el total con transporte.'],
          ['fa-solid fa-qrcode', `Separa con el ${reglas.adelanto_pct}%`, 'Paga con Yape o Plin, sube la captura y avísanos por WhatsApp.'],
          ['fa-solid fa-handshake', 'Confirmamos contigo', 'En una llamada o reunión revisamos equipos, lugar y energía. Ahí queda confirmado.'],
          ['fa-solid fa-truck-ramp-box', 'Montamos y suena', 'Llegamos con tiempo, montamos con cables ordenados y probamos el sonido.']
        ].forEach(([icono, titulo, texto], i) => { %>
          <li data-reveal><i class="<%= icono %>"></i><b><%= i + 1 %>. <%= titulo %></b><span><%= texto %></span></li>
        <% }) %>
      </ol>
    </div>
  </section>

  <!-- ================= 8. CONTACTO ================= -->
  <section id="contacto" class="seccion seccion-alt">
    <div class="contenedor">
      <header class="seccion-titulo" data-reveal>
        <span class="seccion-num">Contacto</span>
        <h2>¿Algo muy específico o un evento grande?</h2>
        <p>Escríbenos y te respondemos con una propuesta.</p>
      </header>
      <%# Llamado destacado: las dos formas más rápidas de hablar con una persona, bien visibles. %>
      <div class="contacto-llamado" data-reveal>
        <div>
          <b><i class="fa-solid fa-headset"></i> ¿Prefieres hablar con una persona?</b>
          <span>Te atendemos <%= negocio.horario || 'todos los días' %>. Respondemos en minutos.</span>
        </div>
        <div class="contacto-llamado-botones">
          <a class="btn btn-wa magnetico" href="https://wa.me/<%= negocio.whatsapp %>?text=<%= encodeURIComponent('¡Hola AeeS! Quiero cotizar un evento.') %>" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp"></i> Escribir por WhatsApp</a>
          <a class="btn btn-primario magnetico" href="tel:+51<%= String(negocio.telefono || '').replace(/\D/g, '') %>"><i class="fa-solid fa-phone"></i> Llamar ahora</a>
        </div>
      </div>
      <div class="contacto-grid">
        <div class="contacto-info" data-stagger>
          <a class="contacto-card tilt" href="https://wa.me/<%= negocio.whatsapp %>" target="_blank" rel="noopener" data-reveal>
            <span class="contacto-icono wa"><i class="fa-brands fa-whatsapp"></i></span>
            <div><small>WhatsApp · respuesta rápida</small><strong>+51 <%= String(negocio.telefono || '').replace(/(\d{3})(\d{3})(\d{3})/, '$1 $2 $3') %></strong></div>
            <i class="fa-solid fa-arrow-up-right-from-square"></i>
          </a>
          <button type="button" class="contacto-card tilt copiar-email" data-email="<%= negocio.correo %>" data-reveal>
            <span class="contacto-icono"><i class="fa-regular fa-envelope"></i></span>
            <div><small>Correo · clic para copiar</small><strong><%= negocio.correo %></strong></div>
            <i class="fa-regular fa-copy"></i>
          </button>
          <div class="contacto-card" data-reveal>
            <span class="contacto-icono"><i class="fa-solid fa-location-dot"></i></span>
            <div><small>Almacén · horario</small><strong><%= negocio.direccion %> · <%= negocio.horario %></strong></div>
          </div>
        </div>

        <form class="form-contacto" id="form-contacto" novalidate data-reveal>
          <div class="campo">
            <input id="nombre" name="nombre" type="text" placeholder=" " autocomplete="name" maxlength="80" required>
            <label for="nombre">Nombre</label>
            <small class="campo-error"></small>
          </div>
          <div class="dos-campos">
            <div class="campo">
              <input id="telefono" name="telefono" type="tel" placeholder=" " autocomplete="tel" maxlength="20" required>
              <label for="telefono">Celular</label>
              <small class="campo-error"></small>
            </div>
            <div class="campo">
              <input id="fecha_evento" name="fecha_evento" type="date" placeholder=" ">
              <label for="fecha_evento">Fecha del evento</label>
              <small class="campo-error"></small>
            </div>
          </div>
          <div class="campo">
            <textarea id="mensaje" name="mensaje" rows="5" placeholder=" " maxlength="3000" required></textarea>
            <label for="mensaje">Cuéntanos tu evento</label>
            <small class="campo-error"></small>
            <span class="contador-caracteres"><span id="contador">0</span>/3000</span>
          </div>
          <input type="text" name="web" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">
          <button type="submit" class="btn btn-primario btn-bloque magnetico">
            <span class="btn-texto"><i class="fa-regular fa-paper-plane"></i> Enviar cotización</span>
            <span class="btn-cargando"><i class="fa-solid fa-circle-notch fa-spin"></i> Enviando…</span>
          </button>
          <button type="button" class="btn btn-wa btn-bloque" id="enviar-wa"><i class="fa-brands fa-whatsapp"></i> Mejor enviarlo por WhatsApp</button>
        </form>
      </div>
    </div>
  </section>
</main>

<%# Barra fija en el celular: las dos acciones principales siempre al alcance del pulgar. %>
<nav class="barra-movil" aria-label="Acciones rápidas">
  <a href="#cotizador-rapido" data-scroll class="btn btn-primario"><i class="fa-solid fa-bolt"></i> Cotizar</a>
  <a href="https://wa.me/<%= negocio.whatsapp %>?text=<%= encodeURIComponent('¡Hola AeeS! Quiero cotizar un evento.') %>" class="btn btn-wa" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>
</nav>

<%# Invitación a crear la cuenta con Google (solo si no ha ingresado). %>
<%- include('../partials/aviso-cuenta') %>
<%- include('../partials/modales') %>
<%- include('../partials/footer', { scripts: ['/js/portada.js'] }) %>
