<%#
  equipo-visual.ejs — foto del equipo, o una ilustración SVG según su rol si
  todavía no tiene foto real. Recibe `e` (el equipo).
  Las ilustraciones usan currentColor: en hover se tiñen de dorado desde el CSS.
%>
<% if (e.imagen) { %>
  <img src="<%= e.imagen %>" alt="<%= e.nombre %>" loading="lazy">
<% } else { const r = e.rol; %>
<svg viewBox="0 0 120 160" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <% if (r === 'line_array') { %>
    <rect x="10" y="20" width="100" height="34" rx="6"/><rect x="14" y="60" width="92" height="34" rx="6"/><rect x="18" y="100" width="84" height="34" rx="6"/>
    <circle cx="35" cy="37" r="11"/><circle cx="85" cy="37" r="11"/><circle cx="37" cy="77" r="11"/><circle cx="83" cy="77" r="11"/><circle cx="39" cy="117" r="10"/><circle cx="81" cy="117" r="10"/>
    <path d="M60 8v12M44 8h32"/>
  <% } else if (r === 'top') { %>
    <path d="M22 14h76l8 132H14z"/><circle cx="60" cy="98" r="30"/><circle cx="60" cy="98" r="10"/><path d="M42 34h36l-6 22H48z"/><path d="M60 146v8"/>
  <% } else if (r === 'sub') { %>
    <rect x="8" y="30" width="104" height="110" rx="8"/><circle cx="60" cy="85" r="38"/><circle cx="60" cy="85" r="16"/><path d="M20 128h14M86 128h14"/>
  <% } else if (r === 'consola_digital' || r === 'consola') { %>
    <path d="M8 110l12-60h80l12 60z"/><path d="M14 110v12h92v-12"/>
    <% for (let i = 0; i < 6; i++) { %><path d="<%= `M${28 + i * 13} 62v36` %>"/><rect x="<%= 24 + i * 13 %>" y="<%= 70 + (i % 3) * 8 %>" width="8" height="6" rx="1"/><% } %>
    <% if (r === 'consola_digital') { %><rect x="44" y="30" width="32" height="22" rx="3"/><path d="M52 52v6M68 52v6"/><% } %>
  <% } else if (r === 'mic_vocal' || r === 'mic_inalambrico') { %>
    <circle cx="60" cy="34" r="20"/><path d="M46 26h28M44 36h32M46 46h28"/><path d="M48 52l6 90h12l6-90"/>
    <% if (r === 'mic_inalambrico') { %><path d="M84 16c8 6 8 30 0 36M92 10c12 10 12 38 0 48"/><% } %>
  <% } else if (r === 'amplificador') { %>
    <rect x="6" y="56" width="108" height="48" rx="5"/><circle cx="26" cy="80" r="8"/><circle cx="48" cy="80" r="8"/><path d="M66 72h34M66 80h34M66 88h22"/><path d="M6 64h-2M114 64h2"/>
  <% } else if (r === 'cabeza_movil') { %>
    <path d="M30 140h60l-6-14H36z"/><path d="M34 126V92M86 126V92"/><path d="M34 92c0-28 52-28 52 0"/><rect x="38" y="40" width="44" height="50" rx="16" transform="rotate(-18 60 65)"/><path d="M52 40L36 4M68 36L60 0" opacity=".6"/>
  <% } else if (r === 'par_led') { %>
    <path d="M30 40h60v70a30 14 0 0 1-60 0z"/><ellipse cx="60" cy="40" rx="30" ry="10"/><% for (let i = 0; i < 3; i++) { for (let j = 0; j < 3; j++) { %><circle cx="<%= 46 + i * 14 %>" cy="<%= 62 + j * 14 %>" r="3"/><% } } %><path d="M22 70h-8v40h8M98 70h8v40h-8"/>
  <% } else if (r === 'luz_efecto') { %>
    <rect x="12" y="44" width="96" height="72" rx="6"/><% for (let i = 0; i < 4; i++) { for (let j = 0; j < 3; j++) { %><circle cx="<%= 30 + i * 20 %>" cy="<%= 62 + j * 18 %>" r="6"/><% } } %>
  <% } else if (r === 'humo') { %>
    <rect x="16" y="86" width="74" height="44" rx="6"/><path d="M90 100h14"/><path d="M106 96c10-6 6-18-2-20 2-10-10-16-16-10-4-8-16-6-16 4"/><path d="M28 130v10M78 130v10"/>
  <% } else if (r === 'dmx') { %>
    <rect x="6" y="60" width="108" height="50" rx="6"/><% for (let i = 0; i < 8; i++) { %><path d="<%= `M${18 + i * 12} 70v20` %>"/><% } %><rect x="16" y="96" width="30" height="8" rx="2"/>
  <% } else if (r === 'led_panel') { %>
    <rect x="6" y="26" width="108" height="78" rx="4"/><path d="M6 52h108M6 78h108M42 26v78M78 26v78"/><path d="M40 104l-8 40M80 104l8 40M28 144h64"/>
  <% } else if (r === 'kit_cables') { %>
    <path d="M60 24c-34 0-40 34-14 44s26 30-6 40-22 36 20 30"/><path d="M60 24h18v12H60M60 138h18v12H60"/><circle cx="34" cy="96" r="14"/><circle cx="90" cy="64" r="12"/>
  <% } else if (r === 'stand') { %>
    <path d="M60 10v100M60 110l-40 40M60 110l40 40M60 110v40"/><rect x="50" y="4" width="20" height="14" rx="3"/><path d="M48 70h24"/>
  <% } else { %>
    <rect x="14" y="30" width="92" height="100" rx="12"/><circle cx="60" cy="80" r="24"/>
  <% } %>
</svg>
<% } %>
