<%#
  aviso-cuenta.ejs — invitación a crear la cuenta, en la portada, solo para quien NO ha ingresado.
  Por qué: el cliente nuevo no suele buscar el ícono de "Ingresar"; esta tarjeta se lo ofrece
  en la primera pantalla con el beneficio concreto (puntos → descuento) y el botón de Google,
  que es lo más rápido (un toque; luego solo se pide el celular en /cuenta/completar).

  Flujo:
   1. La tarjeta entra deslizándose a los 2,5 s (main.js → initAvisoCuenta).
   2. "Continuar con Google" → Google llama a aeesGoogle() (public/js/google.js), que envía el
      token a POST /cuenta/google y redirige: si es nuevo, a completar el celular.
      Sin GOOGLE_CLIENT_ID configurado se muestra un botón normal a /cuenta/ingresar.
   3. "Ahora no" la oculta 7 días en este dispositivo (localStorage 'aees_aviso_cuenta').
%>
<% if (!usuario) { %>
<aside class="aviso-cuenta" id="aviso-cuenta" aria-labelledby="aviso-cuenta-titulo">
  <button type="button" class="aviso-cuenta-cerrar" data-cerrar-aviso aria-label="Cerrar la invitación"><i class="fa-solid fa-xmark"></i></button>
  <div class="aviso-cuenta-icono" aria-hidden="true"><i class="fa-solid fa-gift"></i></div>
  <div class="aviso-cuenta-cuerpo">
    <span class="aviso-cuenta-etiqueta">Cliente nuevo</span>
    <h2 id="aviso-cuenta-titulo">Crea tu cuenta <span class="texto-acento">en un toque</span></h2>
    <p>Guardamos tus datos para la próxima reserva y <b>sumas puntos</b>: cada <%= reglas?.puntos_canje || 5 %> puntos te descontamos <b>S/ <%= reglas?.soles_canje || 50 %></b>.</p>
    <% if (googleClientId) { %>
      <div id="g_id_onload" data-client_id="<%= googleClientId %>" data-callback="aeesGoogle" data-auto_prompt="false" data-ux_mode="popup" data-volver="<%= rutaActual %>"></div>
      <div class="g_id_signin" data-type="standard" data-shape="pill" data-theme="outline" data-size="large" data-text="continue_with" data-locale="es" data-width="260"></div>
    <% } else { %>
      <a class="btn btn-primario" href="/cuenta/ingresar?volver=<%= encodeURIComponent(rutaActual) %>"><i class="fa-solid fa-user-plus"></i> Crear mi cuenta gratis</a>
    <% } %>
    <button type="button" class="aviso-cuenta-luego" data-cerrar-aviso>Ahora no</button>
  </div>
</aside>
<% if (googleClientId) { %>
<script src="/js/google.js"></script>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<% } %>
<% } %>
