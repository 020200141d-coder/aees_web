<%#
  footer.ejs — pie, botones flotantes (Google, WhatsApp y volver arriba), cursor y scripts.
  El botón de Google (con su "G" de colores) solo aparece si el visitante no ha ingresado.
  El WhatsApp flotante lleva una burbuja "¿Cotizamos tu evento?" que aparece a los 6 s,
  una vez por visita (main.js → initBurbujaWa), para que el contacto llame la atención.
  `scripts` (opcional) = lista de scripts extra de la página (asistente.js, mi-evento.js...).
  Orden: librerías por CDN → evento.js (carrito compartido) → main.js → scripts de la página.
%>
<footer class="footer">
  <div class="contenedor">
    <div class="footer-grid">
      <div>
        <a href="/" class="logo logo-footer" aria-label="AeeS Acústico, inicio"><%- include('logo', { completo: true }) %></a>
        <p style="margin-top:.8rem; max-width: 380px"><%= negocio.descripcion %></p>
        <div class="footer-redes">
          <% if (negocio.redes?.instagram) { %><a href="<%= negocio.redes.instagram %>" target="_blank" rel="noopener" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a><% } %>
          <% if (negocio.redes?.facebook) { %><a href="<%= negocio.redes.facebook %>" target="_blank" rel="noopener" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a><% } %>
          <% if (negocio.redes?.tiktok) { %><a href="<%= negocio.redes.tiktok %>" target="_blank" rel="noopener" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a><% } %>
          <a href="https://wa.me/<%= negocio.whatsapp %>" target="_blank" rel="noopener" aria-label="WhatsApp"><i class="fa-brands fa-whatsapp"></i></a>
        </div>
      </div>
      <div>
        <h4>Explora</h4>
        <ul>
          <li><a href="/combos">Combos y paquetes</a></li>
          <li><a href="/catalogo">Catálogo de equipos</a></li>
          <li><a href="/eventos">Eventos realizados</a></li>
          <li><a href="/asistente">Arma tu evento con IA</a></li>
          <li><a href="/cuenta">Mis reservas</a></li>
        </ul>
      </div>
      <div>
        <h4>Contacto</h4>
        <ul>
          <li><i class="fa-brands fa-whatsapp"></i> <a href="https://wa.me/<%= negocio.whatsapp %>" target="_blank" rel="noopener"><%= negocio.telefono %></a></li>
          <li><i class="fa-regular fa-envelope"></i> <%= negocio.correo %></li>
          <li><i class="fa-solid fa-location-dot"></i> <%= negocio.direccion %></li>
          <li><i class="fa-regular fa-clock"></i> <%= negocio.horario %></li>
        </ul>
      </div>
    </div>
    <div class="footer-base">
      <span>&copy; <%= anio %> <%= negocio.nombre %>. Cusco, Perú.</span>
      <span><%= portada.fuentes || '' %> Mapas © OpenStreetMap.</span>    </div>
  </div>
</footer>

<div class="flotantes">
  <button class="volver-arriba" id="volver-arriba" aria-label="Volver arriba">
    <svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="21" /></svg>
    <i class="fa-solid fa-arrow-up"></i>
  </button>
  <div class="wa-burbuja" id="wa-burbuja" hidden>
    <button type="button" class="wa-burbuja-cerrar" aria-label="Cerrar el mensaje"><i class="fa-solid fa-xmark"></i></button>
    <a href="https://wa.me/<%= negocio.whatsapp %>?text=<%= encodeURIComponent('¡Hola AeeS! Quiero cotizar un evento.') %>" target="_blank" rel="noopener">
      <b>¿Cotizamos tu evento? 👋</b>
      <span>Escríbenos por WhatsApp, respondemos rápido.</span>
    </a>
  </div>
  <%# Ingreso con Google flotante (solo sin sesión): lleva a /cuenta/ingresar, donde está el botón oficial de Google. %>
  <% if (!usuario && rutaActual !== '/cuenta/ingresar' && rutaActual !== '/cuenta/completar') { %>
  <a class="google-flotante" href="/cuenta/ingresar?volver=<%= encodeURIComponent(rutaActual) %>" aria-label="Ingresar con Google">
    <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.6 5.4 2.7 13.3l7.9 6.1C12.5 13.6 17.8 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.7 6c4.5-4.2 6.9-10.3 6.9-17.7z"/><path fill="#FBBC05" d="M10.6 28.6A14.6 14.6 0 0 1 9.5 24c0-1.6.3-3.2.8-4.6l-7.9-6.1A23.9 23.9 0 0 0 0 24c0 3.9.9 7.5 2.6 10.7l8-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.7-6c-2.2 1.5-5 2.3-8.2 2.3-6.2 0-11.5-4.2-13.4-9.9l-8 6.1C6.6 42.6 14.6 48 24 48z"/></svg>
    <span class="google-flotante-texto">Ingresar con Google</span>
  </a>
  <% } %>
  <a class="wa-flotante" href="https://wa.me/<%= negocio.whatsapp %>?text=<%= encodeURIComponent('¡Hola AeeS! Quiero información para un evento.') %>" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp"><i class="fa-brands fa-whatsapp"></i></a>
</div>

<div class="cursor-punto" aria-hidden="true"></div>
<div class="cursor-anillo" aria-hidden="true"></div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="/js/sonido.js"></script>
<script src="/js/evento.js"></script>
<script src="/js/main.js"></script>
<% (typeof scripts !== 'undefined' ? scripts : []).forEach(s => { %><script src="<%= s %>"></script>
<% }) %>
</body>
</html>
