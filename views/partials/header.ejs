<%#
  header.ejs — navegación fija. En la portada los enlaces hacen scroll suave
  (data-scroll); en las demás páginas llevan a /#seccion.
  El contador de "Mi evento" lo actualiza public/js/evento.js con lo que hay en el carrito.
  `solido` = header con fondo desde el inicio (páginas sin hero de foto).
%>
<% const enPortada = rutaActual === '/'; const ir = id => enPortada ? `#${id}` : `/#${id}`; %>
<div class="progreso-lectura" aria-hidden="true"><span></span></div>

<header class="header<%= typeof solido !== 'undefined' && solido ? ' solido' : '' %>" id="header">
  <nav class="nav contenedor" aria-label="Principal">
    <a href="/" class="logo" aria-label="AeeS Acústico, inicio">
      <%- include('logo', { clase: 'logo-header' }) %>
    </a>

    <ul class="nav-links" id="nav-links">
      <li><a href="<%= ir('servicios') %>" <%= enPortada ? 'data-scroll' : '' %>>Servicios</a></li>
      <li><a href="<%= ir('combos') %>" <%= enPortada ? 'data-scroll' : '' %>>Combos</a></li>
      <li><a href="<%= ir('equipos') %>" <%= enPortada ? 'data-scroll' : '' %>>Equipos</a></li>
      <li><a href="<%= ir('eventos') %>" <%= enPortada ? 'data-scroll' : '' %>>Eventos</a></li>
      <li><a href="/asistente" class="<%= rutaActual === '/asistente' ? 'activo' : '' %>">Arma tu evento</a></li>
      <li><a href="<%= ir('contacto') %>" <%= enPortada ? 'data-scroll' : '' %>>Contacto</a></li>
    </ul>

    <div class="nav-acciones">
      <%# Volumen: reemplaza a la antigua pantalla "¿con sonido o sin sonido?". Las barras se mueven cuando está activo. %>
      <button class="btn-icono btn-volumen" id="btn-sonido" type="button" aria-label="Activar sonido del sitio" aria-pressed="false" title="Sonido del sitio">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path class="parlante" d="M4 9h3l5-4v14l-5-4H4z"/><path class="arco arco-1" d="M15.5 9.5a3.5 3.5 0 0 1 0 5"/><path class="arco arco-2" d="M18 7a7 7 0 0 1 0 10"/><path class="silencio" d="M16 9l5 6M21 9l-5 6"/></svg>
      </button>
      <a href="/mi-evento" class="btn-icono" aria-label="Mi evento" title="Mi evento">
        <i class="fa-solid fa-calendar-check"></i>
        <span class="contador-evento" id="contador-evento" aria-live="polite"></span>
      </a>
      <a href="<%= usuario ? (usuario.rol === 'cliente' ? '/cuenta' : '/admin') : '/cuenta/ingresar' %>" class="btn-icono" aria-label="<%= usuario ? 'Mi cuenta' : 'Ingresar' %>" title="<%= usuario ? usuario.nombre : 'Ingresar' %>">
        <i class="fa-<%= usuario ? 'solid' : 'regular' %> fa-user"></i>
      </a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-links">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>
</header>
