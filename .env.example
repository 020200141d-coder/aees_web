# Copia este archivo como .env y completa tus valores. El .env NUNCA se sube a GitHub.
# Todo es opcional salvo ADMIN_EMAIL, ADMIN_PASS y SESSION_SECRET:
# si falta una clave de API, esa función usa su plan B (se explica en cada línea).

# Servidor
PORT=3000
NODE_ENV=development
# URL pública del sitio (en Render: https://tu-app.onrender.com). La usa Mercado Pago para volver.
BASE_URL=

# Cuenta de administrador que se crea sola al arrancar (si ese correo no existe)
ADMIN_EMAIL=
ADMIN_PASS=
# Texto largo y aleatorio para firmar la cookie de sesión
SESSION_SECRET=

# Base de datos Supabase (sin esto se usa data/db.local.json)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# API de IA (Claude, de Anthropic). Sin clave: intérprete por palabras clave y texto armado por reglas
ANTHROPIC_API_KEY=
# Modelo opcional (por defecto claude-opus-5-5)
IA_MODELO=

# Login con Google (Google Cloud Console → Credenciales → ID de cliente OAuth web). Sin esto: solo celular + PIN
GOOGLE_CLIENT_ID=

# Pagos con Mercado Pago (Access Token; uno de prueba empieza con TEST-). Sin esto: Yape manual
MP_ACCESS_TOKEN=
# En desarrollo existe el botón "Simular pago". Pon false para ocultarlo
PAGOS_SIMULADOS=

# Clima con OpenWeather (pronóstico 5 días). Sin clave: Open-Meteo (gratis, sin registro)
OPENWEATHER_API_KEY=
# Rutas con OpenRouteService. Sin clave: servidor público de OSRM
ORS_API_KEY=
